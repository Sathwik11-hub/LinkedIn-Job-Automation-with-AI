"""
Playwright runner script - runs separately from uvicorn to avoid event loop conflicts
Production-ready LinkedIn Easy Apply automation

Key fixes:
- NO time.sleep() - uses wait_for_selector / wait_for_load_state exclusively
- Global per-step timeout = 10s, per-field timeout = 5s
- Field mapping uses EXACT user profile values (no hardcoded data)
- Next button detection with retry logic
- Multi-step form handling with progress validation
- Resume upload with verification
- Fail-safe: skip broken fields, max 2 retries, never infinite loop
- Performance mode: reuse session, limit DOM scans
"""
import asyncio
import sys
import json
import os
import re
from pathlib import Path
from datetime import datetime

# Set UTF-8 encoding for stdout/stderr on Windows
if sys.platform == 'win32':
    import io
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')
    asyncio.set_event_loop_policy(asyncio.WindowsProactorEventLoopPolicy())

from playwright.async_api import async_playwright, Page, BrowserContext

# =========================================================================
# CONSTANTS
# =========================================================================
GLOBAL_STEP_TIMEOUT = 10_000   # 10 seconds per step
FIELD_TIMEOUT = 5_000          # 5 seconds per field interaction
NAV_TIMEOUT = 30_000           # 30 seconds for page navigation
MAX_STEPS = 15                 # Max steps in multi-step form
MAX_FIELD_RETRIES = 2          # Max retries per field
MAX_BUTTON_RETRIES = 2         # Max retries for Next button
MAX_NO_PROGRESS = 3            # Steps with no progress before abort


# =========================================================================
# HELPERS
# =========================================================================

async def _visible_query_all(page_or_elem, selector: str):
    """Query all matching elements, filter to only visible ones."""
    clean_selector = selector.replace(':visible', '')
    try:
        elements = await page_or_elem.query_selector_all(clean_selector)
    except Exception:
        return []
    visible = []
    for el in elements:
        try:
            if await el.is_visible():
                visible.append(el)
        except Exception:
            pass
    return visible


async def _is_button_truly_disabled(btn) -> bool:
    """Check if a button is disabled via attribute, property, or aria-disabled."""
    try:
        if await btn.get_attribute('disabled') is not None:
            return True
        aria = await btn.get_attribute('aria-disabled')
        if aria and aria.lower() == 'true':
            return True
        return await btn.evaluate('el => el.disabled')
    except Exception:
        return False


async def _safe_wait(page: Page, ms: int):
    """Non-blocking wait using Playwright built-in, NOT time.sleep."""
    await page.wait_for_timeout(ms)


async def _wait_for_network(page: Page, timeout: int = GLOBAL_STEP_TIMEOUT):
    """Wait for network idle with timeout - never freeze."""
    try:
        await page.wait_for_load_state("networkidle", timeout=timeout)
    except Exception:
        pass


# =========================================================================
# LABEL -> PROFILE VALUE MAPPING (single source of truth)
# =========================================================================

_CONTACT_LABELS = [
    'first name', 'last name', 'full name', 'name', 'email', 'phone', 'mobile', 'cell',
    'street', 'address', 'city', 'state', 'province', 'zip', 'postal', 'country',
    'linkedin', 'location',
]


def _map_label_to_profile(label: str, user_profile: dict, email: str = '') -> str:
    """Map a form field label to the correct user_profile value.
    Returns EXACT value from profile. Never generates/modifies/guesses."""
    label = label.lower().strip()
    if not label:
        return ''

    # Name fields
    if any(x in label for x in ['first name', 'fname', 'given name', 'first_name']):
        return user_profile.get('first_name', '')
    if any(x in label for x in ['last name', 'lname', 'surname', 'family name', 'last_name']):
        return user_profile.get('last_name', '')
    if any(x in label for x in ['full name', 'your name']) or label.strip() == 'name':
        return user_profile.get('full_name', '')

    # Contact
    if 'email' in label:
        return user_profile.get('email', '') or email
    if any(x in label for x in ['phone', 'mobile', 'cell']):
        return user_profile.get('phone_number', '') or user_profile.get('phone', '')

    # Address
    if any(x in label for x in ['street', 'address']):
        return user_profile.get('address', '') or user_profile.get('street', '') or user_profile.get('street_address', '')
    if any(x in label for x in ['city', 'location (city)']):
        return user_profile.get('city', '')
    if any(x in label for x in ['state', 'province', 'region']):
        return user_profile.get('state', '')
    if any(x in label for x in ['zip', 'postal', 'pincode', 'pin code']):
        return user_profile.get('zip_code', '') or user_profile.get('postal_code', '')
    if 'country' in label and 'code' not in label:
        return user_profile.get('country', '')

    # Generic location
    if 'location' in label and 'job' not in label:
        return user_profile.get('city', '') or user_profile.get('location', '')

    # Professional links
    if 'linkedin' in label:
        return user_profile.get('linkedin_url', '')
    if 'github' in label:
        return user_profile.get('github_url', '')
    if 'portfolio' in label or 'website' in label:
        return user_profile.get('portfolio_url', '') or user_profile.get('website', '')

    # Professional info
    if any(x in label for x in ['current title', 'job title', 'current position', 'designation', 'position title']):
        return user_profile.get('current_title', '')
    if any(x in label for x in ['current company', 'company name', 'employer', 'current employer']):
        return user_profile.get('current_company', '')
    if any(x in label for x in ['skill set', 'skill', 'skills', 'expertise', 'technologies']):
        return user_profile.get('skill_set', '') or user_profile.get('skills', '')
    if 'notice period' in label:
        return str(user_profile.get('notice_period', '')) if user_profile.get('notice_period') else ''

    # Experience
    if any(x in label for x in ['overall experience', 'total experience', 'years of experience', 'work experience']):
        return str(user_profile.get('years_experience', '')) if user_profile.get('years_experience') else ''

    # Salary
    if any(x in label for x in ['expected ctc', 'expected salary', 'salary expectation']):
        return str(user_profile.get('expected_ctc', '') or user_profile.get('expected_salary', ''))
    if any(x in label for x in ['current ctc', 'current salary', 'current compensation']):
        return str(user_profile.get('current_ctc', '')) if user_profile.get('current_ctc') else ''
    if 'ctc' in label or 'salary' in label or 'compensation' in label:
        return str(user_profile.get('ctc', '') or user_profile.get('current_ctc', ''))

    # Education
    if 'gpa' in label or 'cgpa' in label:
        return str(user_profile.get('gpa', '')) if user_profile.get('gpa') else ''

    # Skill-specific experience
    skill_exp = user_profile.get('skill_experience', {})
    for skill, years in skill_exp.items():
        if skill.lower() in label:
            return str(years)
    if any(x in label for x in ['experience', 'years']):
        return str(user_profile.get('years_experience', '')) if user_profile.get('years_experience') else ''

    return ''


def _is_contact_field(label: str) -> bool:
    """True if field should always be overridden with profile data."""
    label = label.lower().strip()
    return any(x in label for x in _CONTACT_LABELS)


def _resolve_yes_no_answer(label: str, user_profile: dict) -> str:
    """Return 'yes' or 'no' for Yes/No questions based on user_profile."""
    label = label.lower()

    if any(x in label for x in ['sponsor', 'require visa', 'need sponsorship', 'immigration']):
        val = str(user_profile.get('sponsorship', 'no')).lower()
        return 'no' if val in ['no', 'false', '0', 'n'] else 'yes'

    if any(x in label for x in ['authorized', 'eligible', 'legally', 'work authorization', 'right to work']):
        val = str(user_profile.get('work_authorization', 'yes')).lower()
        return 'yes' if val in ['yes', 'true', '1', 'y'] else 'no'

    if any(x in label for x in ['relocate', 'willing to relocate', 'relocation']):
        val = str(user_profile.get('relocate', 'yes')).lower()
        return 'yes' if val in ['yes', 'true', '1', 'y'] else 'no'

    if any(x in label for x in [
        'can you', 'do you have', 'are you', 'have you',
        'completed', 'degree', 'education', 'bachelor', 'master',
        'proficient', 'fluent', 'experience with', 'familiar with', 'worked with'
    ]):
        return 'yes'

    return 'yes'


# =========================================================================
# LABEL DETECTION
# =========================================================================

async def get_field_label(page: Page, element) -> str:
    """Get the label text for a form field - handles LinkedIn aria patterns."""
    parts = []
    try:
        aria_label = await element.get_attribute('aria-label')
        if aria_label and aria_label.strip():
            parts.append(aria_label.strip())

        labelledby = await element.get_attribute('aria-labelledby')
        if labelledby:
            for ref_id in labelledby.split():
                try:
                    ref_elem = await page.query_selector(f'#{ref_id}')
                    if ref_elem:
                        text = await ref_elem.text_content()
                        if text and text.strip():
                            parts.append(text.strip())
                except Exception:
                    pass

        elem_id = await element.get_attribute('id')
        if elem_id:
            try:
                label_elem = await page.query_selector(f'label[for="{elem_id}"]')
                if label_elem:
                    text = await label_elem.text_content()
                    if text and text.strip():
                        parts.append(text.strip())
            except Exception:
                pass

        section_text = await element.evaluate('''el => {
            const containers = [
                ".fb-dash-form-element",
                ".artdeco-text-input--container",
                ".jobs-easy-apply-form-section__grouping",
                ".jobs-easy-apply-form-element",
                ".artdeco-form__item",
                "fieldset"
            ];
            for (const sel of containers) {
                const parent = el.closest(sel);
                if (parent) {
                    const lbl = parent.querySelector(
                        'label, [data-test-form-element-label], .fb-dash-form-element__label, ' +
                        'legend, span.t-bold, span.artdeco-text-input__label'
                    );
                    if (lbl && lbl.textContent.trim()) return lbl.textContent.trim();
                }
            }
            return "";
        }''')
        if section_text:
            parts.append(section_text)

        for attr in ['placeholder', 'name', 'id']:
            val = await element.get_attribute(attr)
            if val and val.strip():
                parts.append(val.strip())
                break
    except Exception:
        pass

    return ' '.join(parts).lower()


# =========================================================================
# FORM FIELD FILLING - JS DOM SCANNER (PRIMARY)
# =========================================================================

_JS_SCAN_FIELDS = r"""() => {
    function getLabel(el) {
        let t = el.getAttribute('aria-label') || '';
        if (t.trim()) return t.trim();
        const llby = el.getAttribute('aria-labelledby');
        if (llby) {
            t = llby.split(' ')
                .map(id => { const e = document.getElementById(id); return e ? e.textContent.trim() : ''; })
                .filter(Boolean).join(' ').trim();
            if (t) return t;
        }
        if (el.id) {
            const lbl = document.querySelector('label[for="' + el.id + '"]');
            if (lbl && lbl.textContent.trim()) return lbl.textContent.trim();
        }
        const containers = [
            '.fb-dash-form-element', '.artdeco-text-input--container',
            '.jobs-easy-apply-form-section__grouping', '.jobs-easy-apply-form-element',
            '.artdeco-form__item', 'fieldset', '[data-test-form-element]',
            'li', 'div.form-component'
        ];
        for (const sel of containers) {
            try {
                const parent = el.closest(sel);
                if (!parent) continue;
                const lbl = parent.querySelector(
                    'label, legend, span.artdeco-text-input__label, ' +
                    '.fb-dash-form-element__label, span.t-bold, [class*="label"]'
                );
                if (lbl && lbl !== el && lbl.textContent.trim()) return lbl.textContent.trim();
            } catch(e) {}
        }
        return el.placeholder || el.name || el.id || '';
    }
    const results = [];
    for (const el of document.querySelectorAll('input, textarea')) {
        const skip = ['hidden','submit','button','checkbox','radio','file'];
        if (skip.includes(el.type)) continue;
        const rect = el.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) continue;
        if (el.disabled || el.readOnly) continue;
        results.push({
            label: getLabel(el),
            tag: el.tagName.toLowerCase(),
            type: el.type || 'text',
            id: el.id || '',
            name: el.name || '',
            value: el.value || ''
        });
    }
    return results;
}"""


async def fill_form_fields_js(page: Page, user_profile: dict, email: str):
    """PRIMARY filler: JS DOM scanner - reads labels from browser DOM, matches to profile."""
    try:
        fields = await page.evaluate(_JS_SCAN_FIELDS)
    except Exception as e:
        print(f"  [JS-FILL] DOM scan error: {e}")
        return

    print(f"  [JS-FILL] Scanned {len(fields)} visible inputs")

    for info in fields:
        try:
            raw_label = (info.get('label') or '').strip()
            label = raw_label.lower()
            current_val = info.get('value', '')
            field_id = info.get('id', '')
            field_name = info.get('name', '')
            tag = info.get('tag', 'input')

            # Locate element
            elem = None
            if field_id:
                try:
                    elem = await page.query_selector(f'#{field_id}')
                except Exception:
                    pass
            if not elem and field_name:
                try:
                    elem = await page.query_selector(f'{tag}[name="{field_name}"]')
                except Exception:
                    pass
            if not elem:
                continue

            try:
                if not await elem.is_visible():
                    continue
            except Exception:
                continue

            fill_value = _map_label_to_profile(label, user_profile, email)
            is_contact = _is_contact_field(label)

            if fill_value and str(fill_value).strip():
                if is_contact or not current_val.strip():
                    try:
                        await elem.click(timeout=FIELD_TIMEOUT)
                        await elem.fill('', timeout=FIELD_TIMEOUT)
                        await elem.fill(str(fill_value), timeout=FIELD_TIMEOUT)
                        await elem.press('Tab')
                        print(f"    [JS-FILL] '{raw_label[:35]}' = '{str(fill_value)[:25]}'")
                    except Exception as e:
                        print(f"    [JS-FILL] WARN: '{raw_label[:35]}': {str(e)[:40]}")
        except Exception:
            continue

    # Native <select> dropdowns
    await _fill_select_dropdowns(page, user_profile)

    # LinkedIn custom combobox dropdowns
    await _fill_custom_dropdowns(page, user_profile)


async def _fill_select_dropdowns(page: Page, user_profile: dict):
    """Handle native <select> elements."""
    try:
        selects = await _visible_query_all(page, 'select')
        for sel_el in selects:
            try:
                cur = await sel_el.input_value() or ''
                if cur.strip():
                    continue
                label_text = await get_field_label(page, sel_el)
                opts = await sel_el.query_selector_all('option')
                val = await _pick_dropdown_value(label_text, opts, user_profile)
                if val:
                    await sel_el.select_option(val, timeout=FIELD_TIMEOUT)
                    print(f"    [SELECT] '{label_text[:30]}' = '{val[:20]}'")
            except Exception:
                continue
    except Exception:
        pass


async def _fill_custom_dropdowns(page: Page, user_profile: dict):
    """Handle LinkedIn custom combobox dropdowns (aria/listbox pattern)."""
    try:
        triggers = await _visible_query_all(
            page,
            'button[aria-haspopup="listbox"], '
            '[role="combobox"], '
            'select[data-test-text-selectable-option]'
        )
        for trig in triggers:
            try:
                cur_text = (await trig.text_content() or '').strip()
                if cur_text and cur_text.lower() not in ['select an option', 'select', 'choose', '', '--', 'please select']:
                    continue
                label_text = await get_field_label(page, trig)
                await trig.click(timeout=FIELD_TIMEOUT)
                await _safe_wait(page, 250)

                listbox = None
                for lb in await page.query_selector_all('[role="listbox"]'):
                    try:
                        if await lb.is_visible():
                            listbox = lb
                            break
                    except Exception:
                        pass
                if not listbox:
                    await page.keyboard.press('Escape')
                    continue

                opts = await listbox.query_selector_all('[role="option"]')
                if not opts:
                    await page.keyboard.press('Escape')
                    continue

                chosen = await _pick_listbox_option(label_text, opts, user_profile)
                if chosen:
                    await chosen.click(timeout=FIELD_TIMEOUT)
                    opt_txt = (await chosen.text_content() or '').strip()
                    print(f"    [COMBO] '{label_text[:30]}' = '{opt_txt[:20]}'")
                else:
                    await page.keyboard.press('Escape')
            except Exception:
                try:
                    await page.keyboard.press('Escape')
                except Exception:
                    pass
                continue
    except Exception:
        pass


async def _pick_listbox_option(label: str, opts, user_profile: dict):
    """Smart option picker for LinkedIn custom listbox dropdowns."""
    lbl = label.lower()

    # Yes/No questions
    if any(x in lbl for x in ['authorized', 'sponsor', 'relocate', 'willing', 'legally', 'do you', 'have you', 'are you', 'can you']):
        desired = _resolve_yes_no_answer(lbl, user_profile)
        for opt in opts:
            if (await opt.text_content() or '').strip().lower() == desired:
                return opt

    # Salutation
    if any(x in lbl for x in ['salutation', 'prefix', 'title']):
        gender = (user_profile.get('gender', '') or '').lower()
        prefer = 'mr' if gender in ('male', 'm', '') else 'ms'
        for opt in opts:
            if prefer in (await opt.text_content() or '').strip().lower():
                return opt

    # Country
    if 'country' in lbl and 'code' not in lbl:
        cntry = (user_profile.get('country', '') or '').lower()
        for opt in opts:
            if cntry and cntry in (await opt.text_content() or '').lower():
                return opt

    # Job Title
    if any(x in lbl for x in ['job title', 'current title', 'designation']):
        title_val = (user_profile.get('current_title', '') or '').lower()
        for opt in opts:
            ot = (await opt.text_content() or '').strip().lower()
            if title_val and (title_val in ot or ot in title_val):
                return opt

    # Experience range
    if 'experience' in lbl or 'years' in lbl:
        yrs = user_profile.get('years_experience', '')
        if yrs and str(yrs).isdigit():
            yrs_int = int(str(yrs))
            for opt in opts:
                ot = (await opt.text_content() or '').strip().lower()
                nums = re.findall(r'\d+', ot)
                if nums:
                    lo = int(nums[0])
                    hi = int(nums[-1]) if len(nums) > 1 else lo + 2
                    if lo <= yrs_int <= hi:
                        return opt

    # Fallback: first option
    if opts:
        return opts[0]
    return None


async def _pick_dropdown_value(label: str, options, user_profile: dict) -> str:
    """Smart dropdown value picker for native <select>."""
    label = label.lower()

    if any(x in label for x in ['country code', 'phone code']):
        country = (user_profile.get('country', '') or '').lower()
        for opt in options:
            opt_text = (await opt.text_content() or '').lower()
            if country and country in opt_text:
                return await opt.get_attribute('value') or ''
        for opt in options:
            opt_text = (await opt.text_content() or '').lower()
            if 'united states' in opt_text or '+1' in opt_text:
                return await opt.get_attribute('value') or ''

    if any(x in label for x in ['authorized', 'sponsor', 'relocate', 'willing', 'legally',
                                  'do you', 'have you', 'are you', 'can you']):
        desired = _resolve_yes_no_answer(label, user_profile)
        for opt in options:
            opt_text = (await opt.text_content() or '').strip().lower()
            if opt_text == desired:
                return await opt.get_attribute('value') or ''

    if 'experience' in label or 'years' in label:
        yrs = user_profile.get('years_experience', '')
        if yrs and str(yrs).isdigit():
            yrs_int = int(str(yrs))
            for opt in options:
                opt_text = (await opt.text_content() or '').lower().strip()
                nums = re.findall(r'\d+', opt_text)
                if nums:
                    lo = int(nums[0])
                    hi = int(nums[-1]) if len(nums) > 1 else lo + 2
                    if lo <= yrs_int <= hi:
                        return await opt.get_attribute('value') or ''

    if 'degree' in label or 'education' in label:
        edu_level = (user_profile.get('education_level', '') or '').lower()
        for opt in options:
            opt_text = (await opt.text_content() or '').lower()
            if edu_level and edu_level in opt_text:
                return await opt.get_attribute('value') or ''
        for opt in options:
            opt_text = (await opt.text_content() or '').lower()
            if any(x in opt_text for x in ['bachelor', 'b.tech', 'b.e.', 'undergraduate']):
                return await opt.get_attribute('value') or ''

    if 'gender' in label:
        gender = (user_profile.get('gender', '') or '').lower()
        if gender:
            for opt in options:
                if gender in (await opt.text_content() or '').lower():
                    return await opt.get_attribute('value') or ''

    if 'country' in label and 'code' not in label:
        country = (user_profile.get('country', '') or '').lower()
        if country:
            for opt in options:
                if country in (await opt.text_content() or '').lower():
                    return await opt.get_attribute('value') or ''

    for opt in options[1:]:
        value = await opt.get_attribute('value')
        if value and value.strip() and value.lower() not in ['', 'select', 'choose', '-1']:
            return value

    return ""


# =========================================================================
# SECONDARY FILLER - Section-based Q&A
# =========================================================================

async def fill_form_sections(page: Page, user_profile: dict, email: str):
    """Section-based form filler for LinkedIn Easy Apply question sections."""
    filled = 0
    skill_exp = user_profile.get('skill_experience', {})

    def _skill_years(q: str) -> str:
        q_lower = q.lower()
        for skill, years in skill_exp.items():
            if skill.lower() in q_lower:
                return str(years)
        return str(user_profile.get('years_experience', '')) if user_profile.get('years_experience') else ''

    try:
        sections = await page.query_selector_all(
            '.jobs-easy-apply-form-section__grouping, '
            '.fb-dash-form-element, '
            '.artdeco-text-input, '
            '.jobs-easy-apply-form-element'
        )

        for section in sections:
            try:
                label_elem = await section.query_selector('label, .fb-dash-form-element__label, span.t-14, span.t-bold')
                q_text = ''
                if label_elem:
                    q_text = (await label_elem.text_content() or '').strip().lower()
                if not q_text:
                    q_text = (await section.text_content() or '').strip().lower()[:200]

                # TEXT INPUTS
                inp = await section.query_selector('input:not([type="hidden"]):not([type="submit"]):not([type="radio"]):not([type="checkbox"]):not([type="file"])')
                if inp:
                    try:
                        if not await inp.is_visible():
                            continue
                    except Exception:
                        continue

                    current_value = await inp.input_value() or ''
                    inp_type = await inp.get_attribute('type') or 'text'
                    is_contact = _is_contact_field(q_text) or inp_type == 'tel'

                    fill_value = _map_label_to_profile(q_text, user_profile, email)

                    if fill_value and str(fill_value).strip():
                        if is_contact or not current_value.strip():
                            try:
                                await inp.click(timeout=FIELD_TIMEOUT)
                                await inp.fill('', timeout=FIELD_TIMEOUT)
                                await inp.fill(str(fill_value), timeout=FIELD_TIMEOUT)
                                await inp.press('Tab')
                                filled += 1
                                print(f"    [SECTION] '{q_text[:35]}' = '{str(fill_value)[:25]}'")
                            except Exception as e:
                                print(f"    [SECTION] WARN: '{q_text[:35]}': {str(e)[:40]}")
                    elif not current_value.strip():
                        if any(x in q_text for x in ['experience', 'years', 'python', 'java', 'react', 'node',
                                                       'aws', 'docker', 'sql', 'ai', 'ml']):
                            sv = _skill_years(q_text)
                            if sv:
                                try:
                                    await inp.click(timeout=FIELD_TIMEOUT)
                                    await inp.fill(sv, timeout=FIELD_TIMEOUT)
                                    await inp.press('Tab')
                                    filled += 1
                                except Exception:
                                    pass
                    continue

                # TEXTAREAS
                textarea = await section.query_selector('textarea')
                if textarea:
                    try:
                        ta_val = await textarea.input_value() or ''
                        if not ta_val.strip():
                            ta_fill = None
                            if any(x in q_text for x in ['skill', 'skills', 'expertise', 'technologies']):
                                ta_fill = user_profile.get('skill_set', '') or user_profile.get('skills', '')
                            elif any(x in q_text for x in ['cover letter', 'why', 'about you', 'summary', 'describe']):
                                ta_fill = user_profile.get('cover_letter', '')
                            elif 'additional' in q_text or 'other' in q_text:
                                ta_fill = 'N/A'
                            if ta_fill and str(ta_fill).strip():
                                await textarea.fill(str(ta_fill), timeout=FIELD_TIMEOUT)
                                filled += 1
                    except Exception:
                        pass
                    continue

                # RADIO BUTTONS
                radios = await section.query_selector_all('input[type="radio"]')
                if radios:
                    any_checked = False
                    for r in radios:
                        try:
                            if await r.is_checked():
                                any_checked = True
                                break
                        except Exception:
                            pass
                    if not any_checked:
                        desired = _resolve_yes_no_answer(q_text, user_profile)
                        selected = False
                        for r in radios:
                            try:
                                r_label = (await get_field_label(page, r)).lower()
                                if desired == 'yes' and 'yes' in r_label:
                                    await r.check(timeout=FIELD_TIMEOUT)
                                    selected = True
                                    filled += 1
                                    break
                                elif desired == 'no' and 'no' in r_label:
                                    await r.check(timeout=FIELD_TIMEOUT)
                                    selected = True
                                    filled += 1
                                    break
                            except Exception:
                                continue
                        if not selected and radios:
                            try:
                                await radios[0].check(timeout=FIELD_TIMEOUT)
                                filled += 1
                            except Exception:
                                pass
                    continue

            except Exception:
                continue

    except Exception as e:
        print(f"  [SECTION-FILL] Error: {str(e)[:50]}")

    # CHECKBOXES (terms/agreements)
    try:
        checkboxes = await _visible_query_all(page, 'input[type="checkbox"]')
        for cb in checkboxes:
            try:
                if await cb.is_checked():
                    continue
                lbl = await get_field_label(page, cb)
                if any(x in lbl for x in ['agree', 'accept', 'acknowledge', 'confirm', 'terms', 'privacy', 'consent']):
                    await cb.check(timeout=FIELD_TIMEOUT)
                    filled += 1
            except Exception:
                continue
    except Exception:
        pass

    if filled > 0:
        print(f"    [SECTION-FILL] Filled {filled} fields")


# =========================================================================
# RESUME UPLOAD
# =========================================================================

async def handle_resume_upload(page: Page, resume_path: str):
    """Detect input[type='file'] and attach resume. Verify filename visible."""
    if not resume_path:
        return False

    if not os.path.isfile(resume_path):
        print(f"  [UPLOAD] ERROR: File not found: {resume_path}")
        return False

    try:
        file_inputs = await page.query_selector_all('input[type="file"]')
        for fi in file_inputs:
            try:
                await fi.set_input_files(resume_path)
                print(f"  [UPLOAD] Attached: {os.path.basename(resume_path)}")
                await _safe_wait(page, 500)

                # Verify
                basename = os.path.basename(resume_path)
                try:
                    body_text = await page.text_content('body')
                    if basename.split('.')[0].lower() in (body_text or '').lower():
                        print(f"  [UPLOAD] Verified filename on page")
                except Exception:
                    pass
                return True
            except Exception:
                continue

        # Fallback: LinkedIn upload labels
        upload_labels = await page.query_selector_all(
            'label[for*="file"], button[aria-label*="upload" i], .jobs-document-upload__upload-button'
        )
        for btn in upload_labels:
            try:
                for_attr = await btn.get_attribute('for')
                if for_attr:
                    hidden_input = await page.query_selector(f'#{for_attr}')
                    if hidden_input:
                        await hidden_input.set_input_files(resume_path)
                        print(f"  [UPLOAD] Attached via label: {os.path.basename(resume_path)}")
                        await _safe_wait(page, 500)
                        return True
            except Exception:
                continue

    except Exception as e:
        print(f"  [UPLOAD] Error: {str(e)[:50]}")
    return False


# =========================================================================
# NEXT / SUBMIT BUTTON LOGIC
# =========================================================================

async def detect_and_click_button(page: Page, dry_run: bool) -> str:
    """
    Detect and click the appropriate button.
    Returns: 'submitted' | 'dry_run' | 'navigated' | 'disabled' | 'not_found'

    Priority:
    1. footer buttons (Submit > Review > Next > Continue)
    2. artdeco-button--primary
    3. button[type="submit"]
    """
    found_disabled = False

    # Priority 1: Modal footer buttons
    modal_footer_selectors = [
        'footer button[aria-label*="Submit"]',
        'footer button[aria-label*="Review"]',
        'footer button[aria-label*="Next"]',
        'footer button[aria-label*="Continue"]',
        '.jobs-easy-apply-modal footer button',
        'div[role="dialog"] footer button',
        'div.artdeco-modal footer button',
    ]

    for footer_sel in modal_footer_selectors:
        try:
            buttons = await page.query_selector_all(footer_sel)
            for btn in buttons:
                if not btn:
                    continue
                if await _is_button_truly_disabled(btn):
                    btn_text_dbg = (await btn.text_content() or '').strip()
                    if any(x in btn_text_dbg.lower() for x in ['next', 'submit', 'review', 'continue']):
                        found_disabled = True
                        print(f"    [BTN] Disabled: '{btn_text_dbg[:20]}'")
                    continue

                btn_text = (await btn.text_content() or '').strip().lower()
                aria_label = (await btn.get_attribute('aria-label') or '').lower()

                if 'submit' in btn_text or 'submit' in aria_label:
                    if dry_run:
                        print(f"  [DRY RUN] Would submit: {btn_text}")
                        return 'dry_run'
                    else:
                        await btn.scroll_into_view_if_needed()
                        await btn.click(timeout=FIELD_TIMEOUT)
                        await _wait_for_network(page)
                        return 'submitted'

                if any(x in btn_text or x in aria_label for x in ['next', 'continue', 'review']):
                    if 'back' not in btn_text and 'dismiss' not in btn_text and 'cancel' not in btn_text:
                        await btn.scroll_into_view_if_needed()
                        await btn.click(timeout=FIELD_TIMEOUT)
                        await _wait_for_network(page)
                        print(f"  [BTN] Clicked: '{btn_text[:20]}'")
                        return 'navigated'
        except Exception:
            continue

    # Priority 2: Primary action buttons
    try:
        primary_btns = await _visible_query_all(page, 'button.artdeco-button--primary')
        for pb in primary_btns:
            if await _is_button_truly_disabled(pb):
                found_disabled = True
                continue
            btn_text = (await pb.text_content() or '').strip()
            if 'back' in btn_text.lower() or 'dismiss' in btn_text.lower():
                continue
            if 'submit' in btn_text.lower():
                if dry_run:
                    print(f"  [DRY RUN] Would submit: {btn_text}")
                    return 'dry_run'
                else:
                    await pb.scroll_into_view_if_needed()
                    await pb.click(timeout=FIELD_TIMEOUT)
                    await _wait_for_network(page)
                    return 'submitted'
            else:
                await pb.scroll_into_view_if_needed()
                await pb.click(timeout=FIELD_TIMEOUT)
                await _wait_for_network(page)
                print(f"  [BTN] Clicked primary: '{btn_text[:20]}'")
                return 'navigated'
    except Exception:
        pass

    # Priority 3: Generic submit buttons
    try:
        submit_btns = await _visible_query_all(page, 'button[type="submit"]')
        for sb in submit_btns:
            if await _is_button_truly_disabled(sb):
                found_disabled = True
                continue
            btn_text = (await sb.text_content() or '').strip()
            if dry_run:
                print(f"  [DRY RUN] Would submit: {btn_text}")
                return 'dry_run'
            else:
                await sb.scroll_into_view_if_needed()
                await sb.click(timeout=FIELD_TIMEOUT)
                await _wait_for_network(page)
                return 'submitted'
    except Exception:
        pass

    return 'disabled' if found_disabled else 'not_found'


# =========================================================================
# SUCCESS / ERROR CHECKS
# =========================================================================

async def check_application_success(page: Page) -> bool:
    """Check if 'Application sent' message is visible."""
    try:
        body = await page.text_content('body')
        if body and ('Application sent' in body or 'Your application was sent' in body):
            return True
    except Exception:
        pass
    return False


async def check_validation_errors(page: Page) -> bool:
    """Check for visible validation error messages."""
    try:
        errors = await page.query_selector_all('.artdeco-inline-feedback--error')
        for err in errors:
            try:
                if await err.is_visible():
                    txt = (await err.text_content() or '').strip()
                    if txt:
                        print(f"    [VALIDATION] Error: {txt[:60]}")
                        return True
            except Exception:
                pass
    except Exception:
        pass
    return False


# =========================================================================
# MAIN AUTOMATION FLOW
# =========================================================================

async def run_automation(config_json: str):
    """Run the full LinkedIn Easy Apply automation flow."""
    config = json.loads(config_json)

    # Build user_profile - use ONLY user-provided data
    user_profile = config.get('user_profile', {})
    if user_profile.get('phone_number') and not user_profile.get('phone'):
        user_profile['phone'] = user_profile['phone_number']
    elif user_profile.get('phone') and not user_profile.get('phone_number'):
        user_profile['phone_number'] = user_profile['phone']
    if not user_profile.get('full_name'):
        user_profile['full_name'] = f"{user_profile.get('first_name', '')} {user_profile.get('last_name', '')}".strip()
    user_profile.setdefault('skill_experience', {})
    config['user_profile'] = user_profile

    # Log profile values being used
    print(f"[PROFILE] first_name='{user_profile.get('first_name')}' last_name='{user_profile.get('last_name')}'")
    print(f"[PROFILE] email='{user_profile.get('email')}' phone='{user_profile.get('phone_number')}'")
    print(f"[PROFILE] city='{user_profile.get('city')}' state='{user_profile.get('state')}' zip='{user_profile.get('zip_code')}'")
    print(f"[PROFILE] country='{user_profile.get('country')}' address='{user_profile.get('address')}'")
    print(f"[PROFILE] linkedin='{user_profile.get('linkedin_url')}' title='{user_profile.get('current_title')}'")

    result = {
        "status": "failed",
        "phase": "",
        "jobs_found": 0,
        "applications": [],
        "errors": []
    }

    playwright = None
    context = None
    page = None

    try:
        print("[INIT] Starting Playwright automation...")
        playwright = await async_playwright().start()

        profile_dir = Path("browser_profile")
        profile_dir.mkdir(exist_ok=True)
        screenshots_dir = Path("data/screenshots")
        screenshots_dir.mkdir(parents=True, exist_ok=True)

        # Clean lock files
        for lock_name in ["SingletonLock", "SingletonSocket", "SingletonCookie"]:
            lock_file = profile_dir / lock_name
            if lock_file.exists():
                try:
                    lock_file.unlink()
                except Exception:
                    pass

        headless = config.get('headless', False)
        print(f"[BROWSER] Launching (headless={headless})...")

        context = await playwright.chromium.launch_persistent_context(
            str(profile_dir),
            headless=headless,
            slow_mo=30,
            args=[
                '--disable-blink-features=AutomationControlled',
                '--disable-dev-shm-usage',
                '--no-sandbox',
                '--disable-gpu',
                '--disable-web-security',
                '--disable-features=IsolateOrigins,site-per-process',
            ],
            viewport={'width': 1920, 'height': 1080},
            user_agent='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
            locale='en-US',
            timezone_id='America/New_York',
            ignore_https_errors=True,
        )

        page = context.pages[0] if context.pages else await context.new_page()
        page.set_default_timeout(GLOBAL_STEP_TIMEOUT)
        page.set_default_navigation_timeout(NAV_TIMEOUT)

        # Anti-detection
        await context.add_init_script("""
            Object.defineProperty(navigator, 'webdriver', {get: () => undefined});
            Object.defineProperty(navigator, 'plugins', {get: () => [1, 2, 3, 4, 5]});
            window.chrome = {runtime: {}};
        """)

        print("[OK] Browser initialized")
        result["phase"] = "browser_initialized"

        # =================== LOGIN ===================
        print("\n[LOGIN] Starting LinkedIn login...")
        li_email = config.get('linkedin_email')
        li_password = config.get('linkedin_password')

        if not li_email or not li_password:
            raise Exception("LinkedIn credentials not provided")

        await page.goto('https://www.linkedin.com', wait_until='domcontentloaded', timeout=NAV_TIMEOUT)
        await _safe_wait(page, 1000)

        current_url = page.url
        logged_in = any(p in current_url for p in ['/feed', '/mynetwork', '/jobs', '/in/'])

        if not logged_in:
            await page.goto('https://www.linkedin.com/login', wait_until='domcontentloaded', timeout=NAV_TIMEOUT)
            await _safe_wait(page, 500)

            # Fill email
            for sel in ['input[name="session_key"]', 'input#username', 'input[autocomplete="username"]']:
                try:
                    elem = await page.wait_for_selector(sel, timeout=FIELD_TIMEOUT)
                    if elem:
                        await elem.fill(li_email, timeout=FIELD_TIMEOUT)
                        print(f"[LOGIN] Email filled")
                        break
                except Exception:
                    continue

            # Fill password
            for sel in ['input[name="session_password"]', 'input#password', 'input[type="password"]']:
                try:
                    elem = await page.wait_for_selector(sel, timeout=FIELD_TIMEOUT)
                    if elem:
                        await elem.fill(li_password, timeout=FIELD_TIMEOUT)
                        print(f"[LOGIN] Password filled")
                        break
                except Exception:
                    continue

            # Submit
            try:
                await page.click('button[type="submit"]', timeout=FIELD_TIMEOUT)
            except Exception:
                pass
            await _wait_for_network(page)
            await _safe_wait(page, 2000)

            current_url = page.url
            if any(p in current_url for p in ['/feed', '/mynetwork', '/jobs', '/check/add-phone', '/in/']):
                logged_in = True
                print("[OK] Login successful!")
            elif 'checkpoint' in current_url or 'challenge' in current_url:
                print("[WARN] Security checkpoint - waiting 60s...")
                await _safe_wait(page, 60000)
                logged_in = True
            else:
                raise Exception(f"Login may have failed - URL: {current_url}")

        if not logged_in:
            raise Exception("Not logged in to LinkedIn")
        result["phase"] = "logged_in"

        # =================== JOB SEARCH ===================
        print("\n[SEARCH] Starting job search...")
        import urllib.parse
        keyword = config.get('keyword', 'Software Engineer')
        location = config.get('location', 'Remote')
        search_url = f'https://www.linkedin.com/jobs/search/?keywords={urllib.parse.quote(keyword)}&location={urllib.parse.quote(location)}&f_AL=true&sortBy=R'

        print(f"[SEARCH] Keyword: {keyword}, Location: {location}")
        await page.goto(search_url, wait_until='domcontentloaded', timeout=NAV_TIMEOUT)
        await _wait_for_network(page)
        await _safe_wait(page, 1500)
        result["phase"] = "searching"

        # =================== JOB COLLECTION ===================
        print("\n[COLLECT] Collecting job listings...")

        for i in range(3):
            await page.evaluate('window.scrollTo(0, document.body.scrollHeight)')
            await _safe_wait(page, 400)
        await page.evaluate('window.scrollTo(0, 0)')
        await _safe_wait(page, 300)

        job_card_selectors = [
            'li.scaffold-layout__list-item',
            'li.jobs-search-results__list-item',
            'div.job-card-container',
            'div[data-job-id]',
            '.jobs-search-results__list > li',
            '.scaffold-layout__list > li',
            'ul.scaffold-layout__list-container > li',
        ]

        job_cards = []
        for selector in job_card_selectors:
            try:
                cards = await page.query_selector_all(selector)
                if cards and len(cards) > 0:
                    job_cards = cards
                    print(f"[OK] Found {len(cards)} job cards: {selector}")
                    break
            except Exception:
                continue

        jobs = []
        max_jobs = config.get('max_applications', 5)

        for i, card in enumerate(job_cards[:max_jobs * 2]):
            try:
                await card.scroll_into_view_if_needed()
                await _safe_wait(page, 200)
                await card.click(timeout=FIELD_TIMEOUT)
                await _safe_wait(page, 800)

                title = None
                for sel in [
                    'h1.job-details-jobs-unified-top-card__job-title',
                    'h1.jobs-unified-top-card__job-title',
                    'h1.t-24.t-bold.inline',
                    'h2.job-details-jobs-unified-top-card__job-title',
                    '.job-details-jobs-unified-top-card__job-title',
                    'a.job-card-container__link span',
                ]:
                    try:
                        elem = await page.query_selector(sel)
                        if elem:
                            title = (await elem.text_content() or '').strip()
                            if title:
                                break
                    except Exception:
                        continue

                company = None
                for sel in [
                    'a.job-details-jobs-unified-top-card__company-name',
                    'span.job-details-jobs-unified-top-card__company-name',
                    '.jobs-unified-top-card__company-name',
                    '.job-card-container__company-name',
                ]:
                    try:
                        elem = await page.query_selector(sel)
                        if elem:
                            company = (await elem.text_content() or '').strip()
                            if company:
                                break
                    except Exception:
                        continue
                if not company:
                    company = "Unknown Company"

                easy_apply = False
                for sel in ['button.jobs-apply-button', 'button[aria-label*="Easy Apply"]', 'button:has-text("Easy Apply")']:
                    try:
                        btn = await page.query_selector(sel)
                        if btn:
                            btn_text = await btn.text_content() or ""
                            if 'easy' in btn_text.lower() or 'apply' in btn_text.lower():
                                easy_apply = True
                                break
                    except Exception:
                        continue

                if title and easy_apply:
                    jobs.append({
                        'index': i + 1,
                        'title': title[:100],
                        'company': company[:50],
                        'url': page.url,
                        'easy_apply': True
                    })
                    print(f"  [+] Job {len(jobs)}: {title[:45]}... @ {company[:20]}")
                    if len(jobs) >= max_jobs:
                        break
            except Exception as e:
                print(f"  [WARN] Card {i+1}: {str(e)[:40]}")
                continue

        result["jobs_found"] = len(jobs)
        result["phase"] = "jobs_collected"
        print(f"\n[OK] Collected {len(jobs)} Easy Apply jobs")

        # =================== APPLICATION PHASE ===================
        dry_run = config.get('dry_run', True)
        resume_path = config.get('resume_path', '')
        li_email_for_fill = config.get('linkedin_email', '')

        print(f"\n[APPLY] Starting applications (dry_run={dry_run})...")

        for job in jobs[:max_jobs]:
            try:
                print(f"\n[APPLY] Applying to: {job['title'][:40]} @ {job['company']}")

                await page.goto(job['url'], wait_until='domcontentloaded', timeout=NAV_TIMEOUT)
                await _safe_wait(page, 1000)

                # Click Easy Apply
                clicked = False
                for sel in ['button.jobs-apply-button', 'button[aria-label*="Easy Apply"]', 'button:has-text("Easy Apply")']:
                    try:
                        btn = await page.wait_for_selector(sel, timeout=FIELD_TIMEOUT)
                        if btn:
                            await btn.click(timeout=FIELD_TIMEOUT)
                            clicked = True
                            print("  [OK] Clicked Easy Apply")
                            break
                    except Exception:
                        continue

                if not clicked:
                    job['status'] = 'FAILED'
                    job['error'] = 'Could not click Easy Apply'
                    result["applications"].append(job)
                    continue

                await _wait_for_network(page)
                await _safe_wait(page, 500)

                # =================== MULTI-STEP FORM LOOP ===================
                consecutive_no_progress = 0

                for step in range(MAX_STEPS):
                    await _safe_wait(page, 200)

                    # Check success
                    if await check_application_success(page):
                        job['status'] = 'APPLIED'
                        print("  [SUCCESS] Application submitted!")
                        break

                    print(f"  [STEP {step+1}] Filling form...")

                    # Fill using both methods
                    await fill_form_fields_js(page, user_profile, li_email_for_fill)
                    await fill_form_sections(page, user_profile, li_email_for_fill)

                    # Resume upload
                    if resume_path:
                        await handle_resume_upload(page, resume_path)

                    # Let LinkedIn validate
                    await _safe_wait(page, 700)

                    # Re-fill on validation errors
                    if await check_validation_errors(page):
                        print(f"    [RETRY] Re-filling after validation errors...")
                        await fill_form_fields_js(page, user_profile, li_email_for_fill)
                        await fill_form_sections(page, user_profile, li_email_for_fill)
                        await _safe_wait(page, 700)

                    # Check success after fill
                    if await check_application_success(page):
                        job['status'] = 'APPLIED'
                        print("  [SUCCESS] Application submitted!")
                        break

                    # Click Next/Submit/Review/Continue
                    btn_result = await detect_and_click_button(page, dry_run)

                    if btn_result == 'submitted':
                        job['status'] = 'APPLIED'
                        print("  [SUCCESS] Application submitted!")
                        break
                    elif btn_result == 'dry_run':
                        job['status'] = 'DRY_RUN'
                        break
                    elif btn_result == 'navigated':
                        consecutive_no_progress = 0
                        await _safe_wait(page, 500)
                    elif btn_result == 'disabled':
                        # Button disabled - re-fill and retry once
                        print(f"    [RETRY] Button disabled - re-filling...")
                        await fill_form_fields_js(page, user_profile, li_email_for_fill)
                        await fill_form_sections(page, user_profile, li_email_for_fill)
                        await _safe_wait(page, 1000)

                        btn_result2 = await detect_and_click_button(page, dry_run)
                        if btn_result2 in ('submitted', 'dry_run'):
                            job['status'] = 'APPLIED' if btn_result2 == 'submitted' else 'DRY_RUN'
                            break
                        elif btn_result2 == 'navigated':
                            consecutive_no_progress = 0
                        else:
                            consecutive_no_progress += 1
                    else:
                        consecutive_no_progress += 1
                        print(f"  [WARN] No button found (streak={consecutive_no_progress})")

                    if consecutive_no_progress >= MAX_NO_PROGRESS:
                        print(f"  [ABORT] {consecutive_no_progress} steps no progress")
                        break

                if not job.get('status'):
                    job['status'] = 'INCOMPLETE'

                result["applications"].append(job)

                # Close modal
                try:
                    for dismiss_sel in ['button[aria-label="Dismiss"]', 'button[aria-label="Close"]', 'button.artdeco-modal__dismiss']:
                        btn = await page.query_selector(dismiss_sel)
                        if btn:
                            await btn.click(timeout=FIELD_TIMEOUT)
                            break
                except Exception:
                    pass

                # Discard confirmation
                try:
                    discard_btn = await page.query_selector('button[data-control-name="discard_application_confirm_btn"], button:has-text("Discard")')
                    if discard_btn and await discard_btn.is_visible():
                        await discard_btn.click(timeout=FIELD_TIMEOUT)
                except Exception:
                    pass

                await _safe_wait(page, 500)

            except Exception as e:
                job['status'] = 'FAILED'
                job['error'] = str(e)[:100]
                result["applications"].append(job)
                print(f"  [ERROR] {str(e)[:50]}")

                # Fail-safe: close modals
                try:
                    await page.keyboard.press('Escape')
                    await _safe_wait(page, 300)
                except Exception:
                    pass

        result["status"] = "completed"
        result["phase"] = "completed"

        applied_count = len([a for a in result["applications"] if a.get('status') in ['APPLIED', 'DRY_RUN']])
        print(f"\n[DONE] Automation complete!")
        print(f"       Jobs found: {result['jobs_found']}")
        print(f"       Applied: {applied_count}/{len(result['applications'])}")

    except Exception as e:
        result["errors"].append(str(e))
        print(f"\n[FATAL] Error: {str(e)}")

        # Fail-safe: try reload on crash
        if page:
            try:
                print("[RECOVERY] Reloading page...")
                await page.reload(timeout=NAV_TIMEOUT)
            except Exception:
                pass

    finally:
        if page:
            try:
                await _safe_wait(page, 1000)
            except Exception:
                pass

        if context:
            try:
                await context.close()
            except Exception:
                pass
        if playwright:
            try:
                await playwright.stop()
            except Exception:
                pass
        print("[CLOSED] Browser closed")

    return result


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python playwright_runner.py <config_json>")
        sys.exit(1)

    config_json = sys.argv[1]
    result = asyncio.run(run_automation(config_json))

    print("\n===RESULT_JSON===")
    print(json.dumps(result, indent=2))
